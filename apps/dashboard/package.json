{
  "name": "@sitewireai/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --build",
    "serve": "tsc --build && node --env-file-if-exists=.env dist/local-server.js",
    "serve:rc": "tsc --build && node --env-file-if-exists=.env -e \"process.env.SITEWIREAI_MODE=\\\"rc\\\";import(\\\"./dist/local-server.js\\\")\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/client-secrets-manager": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@sitewireai/classify": "workspace:*",
    "@sitewireai/db": "workspace:*",
    "@sitewireai/shared-types": "workspace:*",
    "aws-jwt-verify": "^5.2.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1119.0",
    "@types/node": "^26.2.0"
  }
}
