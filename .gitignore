# Secrets — never commit these. Use a secret manager or your host's env config.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# Dependencies
node_modules/
.pnp.*
__pycache__/
*.py[cod]
.venv/
venv/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Test / coverage
coverage/
.pytest_cache/
.mypy_cache/

# ML artifacts — keep weights and datasets out of git
*.ckpt
*.pt
*.pth
*.onnx
data/raw/
data/interim/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*

# Python tooling
.ruff_cache/

# Terraform — state is residency-bearing and secret-bearing; providers are large.
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# tfvars may carry account-specific values; envs/*.tfvars are deliberate and tracked.
*.auto.tfvars

# Training corpus — real jobsite photographs and one customer's quantities.
# Never in git. Back it up out of band; see apps/trainer/README.md.
apps/trainer/data/

# Model weights and converted training data for the local prelabel assist.
# Weights are downloaded, datasets are third-party — neither belongs in git.
services/prelabel/.venv/
services/prelabel/runs/
services/prelabel/data/
*.pt

# Ultralytics writes run output relative to its own cwd, which lands here.
runs/
dist/
infra/terraform/tfplan.bin
