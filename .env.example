# Variable names only — never values. See ADR-0013.
#
# Runtime secrets are fetched from AWS Secrets Manager by IAM role. This file
# exists so a new engineer learns the shape of the configuration without learning
# its contents, and so CI can assert that nothing required is missing.

# --- Core API (services/*) ---
NODE_ENV=
PORT=
LOG_LEVEL=

# Fetched from Secrets Manager at boot in deployed environments.
# Locally: point at a development database you own.
DATABASE_URL=

# --- AWS ---
AWS_REGION=ca-central-1
# Ingest-only bucket. Unblurred frames may exist here and nowhere else (ADR-0006).
S3_INGEST_STAGING_BUCKET=
# Blurred captures. The only bucket other services may read.
S3_MEDIA_BUCKET=
KMS_KEY_ID=

# --- Auth (ADR-0010) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- Observability (ADR-0011) ---
SENTRY_DSN=
OTEL_SERVICE_NAME=

# --- ML service (services/quantity-ml) ---
QUANTITY_ML_BASE_URL=
# Below this confidence an estimate abstains and routes to a foreman prompt.
# Tunable per model version, never hard-coded (technical plan §5.3, §13.5).
QUANTITY_ABSTAIN_THRESHOLD=
